{
  "name": "settle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "predev": "node scripts/vendor-assets.mjs && node scripts/vendor-paddle.mjs",
    "dev": "vite",
    "prebuild": "node scripts/vendor-assets.mjs && node scripts/vendor-paddle.mjs",
    "build": "tsc -b && vite build",
    "prepreview": "node scripts/vendor-assets.mjs && node scripts/vendor-paddle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/vendor-paddle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "heic-to": "^1.5.2",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "^6.3.289",
    "ppu-paddle-ocr": "6.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "1.0.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.1",
    "pngjs": "^7.0.0",
    "ppu-ocv": "4.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
